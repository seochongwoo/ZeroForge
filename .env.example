# 이 파일을 .env로 복사해 값을 채운다. .env는 절대 커밋하지 않는다.
# backend와 docker-compose가 모두 저장소 루트의 .env를 읽는다.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 웹 클라이언트 주소 (쉼표로 구분)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zeroforge
POSTGRES_USER=zeroforge
POSTGRES_PASSWORD=change-me

# 단일 사용자 토큰 (클라이언트가 Authorization: Bearer 헤더로 보냄)
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
ZF_TOKEN=

# LLM (Step 8)
LLM_API_KEY=
LLM_MODEL=
